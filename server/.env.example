NODE_ENV=development

# Percorso cartella contenuti statici (lasciare vuoto per usare <project-root>/content/)
CONTENT_BASE_PATH=
PORT=3018
MONGODB_PASSWORD=your_mongodb_password
MONGODB_URL=mongodb+srv://stfnbssl_db_user:{password}@cluster0.y3qtgdm.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# Telegram Bot
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_ID=your_telegram_user_id

# Redis Cloud
REDIS_HOST=redis-11976.crce275.eu-west3-1.gcp.cloud.redislabs.com
REDIS_PORT=11976
REDIS_PASSWORD=your_redis_password

# Clerk
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Cloudflare R2 (storage immagini catalogo autori/libri)
# S3 API endpoint: https://<account_id>.r2.cloudflarestorage.com/<bucket>
R2_ACCOUNT_ID=c179a1d686340938c2cd1a37652cabfd
R2_BUCKET=hcaire-assets
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Base pubblica: o `https://pub-<hash>.r2.dev` (abilitando Public Access sul bucket)
# o custom domain configurato via Cloudflare (es. https://cdn.hcaire.it)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=your_ls_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret
# Variant IDs per piano (ottenibili da LS Dashboard > Products > Variants)
LEMONSQUEEZY_VARIANT_ABBONATO=your_abbonato_variant_id
LEMONSQUEEZY_VARIANT_BARTLEBY=your_bartleby_variant_id
LEMONSQUEEZY_VARIANT_BARTLEBY_PLUS=your_bartleby_plus_variant_id

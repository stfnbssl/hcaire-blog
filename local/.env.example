MONGODB_URL=mongodb+srv://stfnbssl_db_user:{password}@cluster0.y3qtgdm.mongodb.net/?appName=Cluster0

REDIS_HOST=redis-11976.crce275.eu-west3-1.gcp.cloud.redislabs.com
REDIS_PORT=11976
REDIS_PASSWORD=your_redis_password

# URL del backend Railway
API_URL=https://hcaire-blog-server-production.up.railway.app/api

# Chiave API per autenticare coworker verso il server
COWORK_API_KEY=your_random_secret_key

# Anthropic API key per il worker Bartleby
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cartella da cui Claude Code lavora (articoli)
COWORK_PROJECT_PATH=C:\Users\nnmrd\Documents\Claude\Projects\Articoli per hcaire blog

# Cartella del progetto Bartleby (Claude Projects HCAIRE skills)
BARTLEBY_PROJECT_PATH=C:\Users\nnmrd\Documents\Claude\Projects\HCAIRE skills

# Telegram — per notifiche di completamento/errore
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_ID=your_telegram_user_id

# ───── Pipeline handler (D6) ─────
# Cartella radice dove vivono i CLAUDE.md degli step (input/produzioni)
PIPELINE_STEPS_ROOT=C:\Users\nnmrd\Documents\Claude\Projects\Sviluppo Bambino\input\produzioni

# Cartella radice degli output JSON prodotti dagli step
PIPELINE_OUTPUT_ROOT=C:\Users\nnmrd\Documents\Claude\Projects\Sviluppo Bambino\output\produzioni

# Cartella radice degli input esterni del ricercatore (default = STEPS_ROOT)
PIPELINE_INPUTS_ROOT=C:\Users\nnmrd\Documents\Claude\Projects\Sviluppo Bambino\input\produzioni

# Cartella dei 6 file precompilati degli assi strutturali (asse_1.json … asse_6.json).
# AGGIORNATA 2026-05-11: ora puntiamo alla source-of-truth nel repo, popolata dal
# rebuild assi (canali hcaire:assi:*). PipelineCommandHandler (F2/F3) legge da qui.
PIPELINE_PRECOMPILED_AXES_DIR=C:\my\projects\hcaire-blog\server\content\progetti\sviluppo bambino\assi strutturali\precompiled

# Cartella di lavoro Cowork (cwd dello spawn)
COWORK_SVILUPPO_BAMBINO_PATH=C:\Users\nnmrd\Documents\Claude\Projects\Sviluppo Bambino

# Modalità mock: true = simula (file output finto, log fittizi). false = spawn reale Cowork.
PIPELINE_MOCK_MODE=true

# ───── Rebuild Assi Strutturali (canali hcaire:assi:*) ─────
# Cartella di lavoro Cowork per il preprocessing assi (cwd dello spawn).
# Distinta da COWORK_SVILUPPO_BAMBINO_PATH: questo Cowork è dedicato al preprocessing.
COWORK_ASSI_PATH=C:\my\claude\claude-cowork\Sviluppo Bambino

# Cartella sorgente dei capitoli .md (read-only, dentro al repo).
NORMALIZED_AXES_DIR=C:\my\projects\hcaire-blog\server\content\progetti\sviluppo bambino\assi strutturali\normalized

# Staging: dove Cowork scrive i 6 JSON prima della promozione (FUORI dal repo).
# I file vengono sovrascritti nei precompiled del repo SOLO se la validazione passa.
AXES_STAGING_DIR=C:\my\claude\claude-cowork\Sviluppo Bambino\output\assi-strutturali\staging

# Source of truth dei 6 JSON degli assi (dentro al repo, controllato da hcaire-blog).
AXES_PRECOMPILED_DIR=C:\my\projects\hcaire-blog\server\content\progetti\sviluppo bambino\assi strutturali\precompiled

# JSON Schema usato da Ajv per validare i file di staging prima di promuoverli.
AXES_SCHEMA_PATH=C:\my\claude\claude-cowork\Sviluppo Bambino\input\assi strutturali\preprocessing\assi-fase-1.json

# CLAUDE.md letto come prompt da AssiPromptComposer.
AXES_CLAUDE_MD_PATH=C:\my\claude\claude-cowork\Sviluppo Bambino\input\assi strutturali\preprocessing\CLAUDE.md

# Root del server (cwd per `npm run assi:archivio` post-rebuild).
ASSI_SERVER_DIR=C:\my\projects\hcaire-blog\server

# Timeout per il rebuild. Cowork richiede ~8 min per asse → setto 60 min per 6 assi.
ASSI_DEFAULT_TIMEOUT_MS=3600000

# Numero di backup dei precompiled da conservare (più vecchi vengono rimossi).
AXES_BACKUPS_TO_KEEP=3

# Modalità mock per il rebuild assi: true = copia i precompiled correnti in staging
# come se Cowork li avesse appena prodotti (test validazione+promozione+upsert).
ASSI_MOCK_MODE=false
